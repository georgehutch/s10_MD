parm ../V1/s10_peptide.prmtop
trajin ../V1/MD/50ns.nc
trajin ../V2.1/MD/50ns.nc
trajin ../V3/MD/50ns.nc
trajin ../V4/MD/50ns.nc
trajin ../V5/MD/50ns.nc
trajin ../V6/MD/50ns.nc
strip :Na+,Cl-,WAT 
rms :1-32
cluster c1 \
 hieragglo epsilon 3.0 clusters 5 averagelinkage \
 rms :33-48@C,N,O,CA,CB&!@H= \
 out cnumvtime.dat \
 summary summary.dat \
 info info.dat \
 cpopvtime cpopvtime.agr normframe \
 repout rep repfmt pdb \
 singlerepout singlerep.nc singlerepfmt netcdf \
 avgout avg avgfmt pdb
run
